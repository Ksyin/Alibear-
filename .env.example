# Add real values in Vercel Project Settings > Environment Variables.
# Never commit .env.local or paste payment, service-account or provider secrets into chat.

# Firebase Admin SDK: paste your service-account JSON as one secret JSON value.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=https://alibearautomation-b95ab-default-rtdb.firebaseio.com
# Comma-separated admin emails (the first dashboard account is also made owner automatically).
ADMIN_EMAILS=
PUBLIC_SITE_URL=https://your-verified-store-domain.example

# Paystack secret: keep only in Vercel environment settings; never commit a live key.
PAYSTACK_SECRET_KEY=

# Cloudinary signed uploads: use the newly rotated secret, not the old disclosed secret.
CLOUDINARY_CLOUD_NAME=ygairs70
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order receipts remain disabled until a sender on a Resend-verified custom domain is ready.
RESEND_FROM=
RESEND_API_KEY=
