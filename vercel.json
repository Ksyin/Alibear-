{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "admin.js", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "checkout.js", "use": "@vercel/static" },
    { "src": "content-editor.js", "use": "@vercel/static" },
    { "src": "customer-account.js", "use": "@vercel/static" },
    { "src": "data.js", "use": "@vercel/static" },
    { "src": "firebase-client.js", "use": "@vercel/static" },
    { "src": "layout.js", "use": "@vercel/static" },
    { "src": "bootstrap-admin.js", "use": "@vercel/node" },
    { "src": "cloudinary-sign.js", "use": "@vercel/node" },
    { "src": "contact-message.js", "use": "@vercel/node" },
    { "src": "link-order.js", "use": "@vercel/node" },
    { "src": "paystack-initialize.js", "use": "@vercel/node" },
    { "src": "paystack-verify.js", "use": "@vercel/node" },
    { "src": "paystack-webhook.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/api/bootstrap-admin/?$", "dest": "/bootstrap-admin.js" },
    { "src": "^/api/cloudinary-sign/?$", "dest": "/cloudinary-sign.js" },
    { "src": "^/api/contact-message/?$", "dest": "/contact-message.js" },
    { "src": "^/api/link-order/?$", "dest": "/link-order.js" },
    { "src": "^/api/paystack-initialize/?$", "dest": "/paystack-initialize.js" },
    { "src": "^/api/paystack-verify/?$", "dest": "/paystack-verify.js" },
    { "src": "^/api/paystack-webhook/?$", "dest": "/paystack-webhook.js" },
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" }
  ]
}
