{
  "rules": {
    "users": {
      // Allow any authenticated client (including anonymous from ESP32)
      // to read/write anywhere under /users – this is needed for the device
      ".read": "auth != null && auth.uid != null",
      ".write": "auth != null && auth.uid != null",

      "$email": {
        // Strict rule for real app users (logged in with email)
        ".read": "auth != null && auth.token.email != null && auth.token.email.replace('.', '_').replace('@', '_') === $email",
        ".write": "auth != null && auth.token.email != null && auth.token.email.replace('.', '_').replace('@', '_') === $email",

        "linked_boards": {
          "$boardId": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },

        "Aquarium": {
          ".read": "auth != null",
          ".write": "auth != null",

          "$device": {
            ".read": "auth != null",
            ".write": "auth != null",

            "switch_state": {
              ".validate": "newData.isString() && (newData.val() === 'ON' || newData.val() === 'OFF')"
            },
            "off_timer": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "schedule_on": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "schedule_off": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            }
          }
        },

        // This covers other systems like "Rooms", "water_tank", etc.
        "$system": {
          ".read": "auth != null",
          ".write": "auth != null",

          "_device_status": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "_acknowledgments": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "sensor_data": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "metadata": {
            ".read": "auth != null",
            ".write": "auth != null"
          },
          "devices": {
            "$device": {
              ".read": "auth != null",
              ".write": "auth != null"
            }
          }
        }
      }
    },

    // ===== NEW: storefront, public read, admin-only write (admin panel) =====
    "products":     { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "journal":      { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "siteContent":  { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "settings":     { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "categories":   { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "banners":      { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "navigation":   { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "pages":        { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "deals":        { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "faqs":         { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "testimonials": { ".read": true, ".write": "auth != null && auth.token.admin === true" },
    "media":        { ".read": true, ".write": "auth != null && auth.token.admin === true" },

    // ===== NEW: admin records (written only by the server) =====
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    // ===== NEW: orders and enquiries =====
    "orders": {
      ".read": "auth != null && auth.token.admin === true",
      "$orderId": {
        ".read": "auth != null && (auth.token.admin === true || auth.uid === data.child('customerUid').val())",
        ".write": "auth != null && auth.token.admin === true"
      }
    },
    "contactRequests": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    }
  }
}
